PULSE_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
PULSE_ADMIN_EMAIL=admin
PULSE_ADMIN_PASSWORD=admin
PULSE_ALLOW_PUBLIC_REGISTRATION=false
# true recarrega o servidor sozinho a cada alteracao de arquivo.
# Sem isso o processo continua servindo o codigo que estava no disco quando subiu.
PULSE_DEBUG=false
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
PULSE_DB_SCHEMA=dashboard_clientes

META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v25.0

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Worker centralizado: 10 minutos, atualiza os ultimos 14 dias e faz backfill gradual.
ADS_SYNC_INTERVAL_SECONDS=600
ADS_SYNC_REFRESH_DAYS=14
ADS_SYNC_BACKFILL_DAYS=550
ADS_SYNC_HISTORY_CHUNK_DAYS=60
